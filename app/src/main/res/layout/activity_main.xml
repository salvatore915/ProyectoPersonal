<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/pc_fondo"
    android:padding="24dp">

    <TextView
        android:id="@+id/textoSaludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_main"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/pc_texto"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textoResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Componentes: 0 | Total: 0,00 €"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/pc_primario"
        android:gravity="center"
        android:padding="12dp"
        android:background="@drawable/fondo_resumen"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/editNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nombre"
        android:textSize="16sp"
        android:textColor="@color/pc_texto"
        android:textColorHint="@color/pc_gris"
        android:background="@drawable/fondo_tarjeta"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editPrecio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_precio"
        android:inputType="numberDecimal"
        android:textSize="16sp"
        android:textColor="@color/pc_texto"
        android:textColorHint="@color/pc_gris"
        android:background="@drawable/fondo_tarjeta"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_tarjeta"
        android:padding="6dp"
        android:layout_marginBottom="24dp">

        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/categorias_pc" />
    </LinearLayout>

    <Button
        android:id="@+id/botonAgregar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/boton_agregar"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/fondo_boton_principal"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/botonVerHistorial"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/boton_ver_historial"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/pc_primario"
        android:background="@drawable/fondo_boton_secundario" />

</LinearLayout>