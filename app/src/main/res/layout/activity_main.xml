<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/pc_fondo"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_main"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/pc_texto"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_nombre"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/editPrecio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_precio"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp" />

    <Spinner
        android:id="@+id/spinnerCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/categorias_pc"
        android:layout_marginVertical="8dp" />

    <!-- Botones para Cámara, Galería y GPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="12dp">

        <Button
            android:id="@+id/btnFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto"
            android:textColor="#FFFFFF"
            android:background="@drawable/fondo_boton_principal"
            app:backgroundTint="@null"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnGaleria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Galería"
            android:textColor="#FFFFFF"
            android:background="@drawable/fondo_boton_principal"
            app:backgroundTint="@null"
            android:layout_marginHorizontal="4dp"/>

        <Button
            android:id="@+id/btnUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS"
            android:textColor="#FFFFFF"
            android:background="@drawable/fondo_boton_principal"
            app:backgroundTint="@null"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Vista previa de la foto -->
    <ImageView
        android:id="@+id/ivFoto"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:background="@drawable/fondo_tarjeta"
        android:layout_marginVertical="8dp"
        android:contentDescription="Vista previa foto" />

    <!-- Texto de coordenadas GPS -->
    <TextView
        android:id="@+id/tvUbicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ubicación: No obtenida"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/pc_gris"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/botonAgregar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boton_agregar"
        android:textColor="#FFFFFF"
        android:background="@drawable/fondo_boton_principal"
        app:backgroundTint="@null"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/botonVerHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/boton_ver_historial"
        android:textColor="#FFFFFF"
        android:background="@drawable/fondo_boton_principal"
        app:backgroundTint="@null" />

    <TextView
        android:id="@+id/textoResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/pc_texto"/>

</LinearLayout>