<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TORRECOMS"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/pc_primario" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_login"
            android:textSize="18sp"
            android:textColor="@color/pc_gris"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/editCorreoLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/fondo_input"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:paddingHorizontal="14dp"
            android:textColor="@color/pc_texto"
            android:textColorHint="@color/pc_gris"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editPasswordLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/fondo_input"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:paddingHorizontal="14dp"
            android:textColor="@color/pc_texto"
            android:textColorHint="@color/pc_gris"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/boton_login"
            android:textColor="#FFFFFF"
            android:background="@drawable/fondo_boton_principal"
            app:backgroundTint="@null"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIrRegistro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/boton_ir_registro"
            android:textColor="@color/pc_primario"
            android:background="@drawable/fondo_boton_secundario"
            app:backgroundTint="@null" />

        <ProgressBar
            android:id="@+id/progressLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>