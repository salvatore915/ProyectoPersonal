<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/fondo_tarjeta"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivProductoOnline"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        android:background="#EFEFEF"
        android:contentDescription="Imagen del producto"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/pc_texto"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvMarcaCategoriaOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/pc_gris"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvValoracionOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/pc_estrella"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tvPrecioOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/pc_primario" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver detalle ›"
            android:textSize="11sp"
            android:textColor="@color/pc_gris"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
